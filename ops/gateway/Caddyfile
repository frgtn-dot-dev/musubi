# Musubi reference gateway.
#
# Puts the web client and the API on ONE public origin, which is what makes
# cookies first-party, removes CORS entirely, and lets the browser call /api/*
# with relative URLs. Everything Musubi assumes about origins depends on this.
#
# PUBLIC_HOST is the hostname Caddy serves. Set it to your domain for automatic
# HTTPS, or to `:80` to run plain HTTP behind another proxy / on a LAN.

{$PUBLIC_HOST::80} {
	encode zstd gzip
	header {
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	# Server-sent events: the API holds these open for as long as a client is
	# connected. Without flush_interval -1 Caddy buffers the response and live
	# updates arrive in clumps (or not at all).
	@stream path /api/stream
	handle @stream {
		reverse_proxy {$API_UPSTREAM:api:7531} {
			flush_interval -1
			transport http {
				# No read timeout: an idle stream is normal, not a stall.
				read_timeout 0
			}
		}
	}

	# The API owns /api/* — Better Auth on /api/auth/*, the REST surface on
	# /api/v1/*, and the federation gateway underneath it.
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:7531}
	}

	# HTML hand-off pages the API serves for links that arrive from outside the
	# app: the emailed password reset, account deletion and email confirmation
	# landings, and the iOS universal-link association. These deliberately stay on
	# the API (they predate the web client and are shared with mobile), so the
	# gateway must not send them to the web app.
	#
	# /invite/* is NOT here: with a web client on this origin, an invitation opens
	# as a page you can read and accept. The API's own invite page is the fallback
	# for API-only installs, where the phone app is the only client there is.
	handle /reset-password {
		reverse_proxy {$API_UPSTREAM:api:7531}
	}
	handle /delete-account {
		reverse_proxy {$API_UPSTREAM:api:7531}
	}
	handle /email-verified {
		reverse_proxy {$API_UPSTREAM:api:7531}
	}
	handle /.well-known/apple-app-site-association {
		reverse_proxy {$API_UPSTREAM:api:7531}
	}

	# The routes the web client owns, listed rather than caught, so that the
	# apex can belong to something else. Keep in sync with apps/web/src/routes —
	# the gateway-routes test fails on a route that is missing here, because the
	# symptom otherwise is a new page quietly serving the marketing 404.
	@webclient path /app /app/* /login /invite/* /e/* /s/* /find-a-time /new-event /healthz /favicon.ico /favicon.svg /assets/* /_serverFn/*
	handle @webclient {
		reverse_proxy {$WEB_UPSTREAM:web:3000}
	}

	# Everything left over, which is `/` and whatever a marketing site puts
	# beside it. MARKETING_UPSTREAM is unset on a self-host, so `/` lands on the
	# web client, whose own `/` redirects to /app — an install with no marketing
	# site opens the app instead of a landing page nobody asked for.
	handle {
		reverse_proxy {$MARKETING_UPSTREAM:web:3000}
	}
}
