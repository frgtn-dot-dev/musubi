{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".output/**",
        ".expo/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
    },
    "storybook": {
      "cache": false,
      "persistent": true,
    }
  }
}
